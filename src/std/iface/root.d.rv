#! the global namespace - fmt, len, inspect, type and metatable helpers, test assertions, channels, sleep and print !#

#* formats a string with %v, %?, %p specifiers (%% is a literal percent) - %v is value (plain), %? is debug (quoted strings, multilined tables), %p is pretty (debug with colors)
string literals also support `#{expr}`, `#{expr:?}`, and `#{expr:p}` interpolation *#
pub declare fmt = fn(format: string, args: any...) -> string

#* returns length of string or table *#
pub declare len = fn(value: any) -> num

#* prints one value and returns it back *#
pub declare inspect = fn(value: any) -> any

#* returns metatable of value or :undef *#
pub declare get_meta = fn(value: any) -> table | :undef

#* sets metatable of value *#
pub declare set_meta = fn(value: any, meta: table|:nil) -> any

#* returns type of value as atom *#
pub declare type = fn(value: any) -> atom

#* returns type of value as atom: nil, num, string, atom, function, table, foreign *#
pub declare typeof = fn(value: any) -> atom

#* used in tests, returns value or :err *#
pub declare expect = fn(value: any) -> !any/:ExpectFailed

#* panics if values are not equal *#
pub declare expect_eq = fn(a: any, b: any) -> !any/:NotEqual

#* panics if value is falsy *#
pub declare assert = fn(value: any) -> any

#* panics if values are not equal *#
pub declare assert_eq = fn(a: any, b: any) -> any

#* sets debug flags from a table *#
pub declare set_debug = fn(flags: table) -> :ok

#* returns debug info as a table *#
pub declare debug = fn() -> table

#* unwraps result, panics if not :ok *#
pub declare unwrap = fn(result: any) -> any

#* creates a new channel with optional buffer size *#
pub declare chan = fn(?capacity: num...) -> {:chan, num}

#* sends value to channel *#
pub declare send = fn(chan: {:chan, num}, value: any) -> :ok

#* receives value from channel, parks if empty *#
pub declare recv = fn(chan: {:chan, num}) -> any

#* sleeps current fiber for given milliseconds *#
pub declare sleep = fn(ms: num) -> parked

#* panics with given message *#
pub declare panic = fn(args: any...) -> never

#* prints values to stdout with space separator *#
pub declare print = fn(args: any...) -> :ok

#* returns a fresh unique symbol-like string, for macro hygiene *#
pub declare gensym = fn() -> string

#* hashes any value *#
pub declare hash = fn(val: any) -> num

# result and option predicates, goes into every compilation like an import
# TODO: do something useful with this
pub macro ok?! `(%what:expr)` `%what[0] == :ok`
pub macro err?! `(%what:expr)` `%what[0] == :err`
pub macro some?! `(%what:expr)` `%what[0] == :some`
pub macro none?! `(%what:expr)` `%what == :none or %what[0] == :none`
pub macro print! `(%fmt:str %ARGS(, %arg:expr)*)` `(print(fmt(%fmt %ARGS(, %arg))))`
