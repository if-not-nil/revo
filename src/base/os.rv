#* the machine you're running *#
pub declare os = {
  #* the command line arguments after the script name, a new table every call *#
  args: fn() -> table,
  #* returns current working directory path *#
  cwd: fn() -> string,
  #* changes cwd to the given path *#
  chdir: fn(path: string) -> !atom,
  #* exits the program with a status *#
  exit: fn(status: number) -> never,
  #* the value of an environment variable or :nil when it isn't set. without a name it's a table of all of them, so `os.env().HOME` *#
  env: fn(?name: string) -> any,
  #* sets an environment variable, returns :ok *#
  setenv: fn(name: string, value: string) -> :ok,
  #* returns current wall-clock time in milliseconds *#
  now: fn() -> number,
  #* returns monotonic clock in milliseconds *#
  clock: fn() -> number,
  #* returns table of directory entries *#
  readdir: fn(path: string) -> !table<{name: string, kind: atom}>,
  #* does path exist? answers :false when missing, raises on unexpected io errors *#
  exists?: fn(path: string) -> bool,
  #*
  removes a file or directory at path
  recursive is optional, defaults to :false: removes a file or empty directory only, :true deletes the whole tree
  *#
  remove: fn(path: string, recursive: bool?) -> !atom,
  #* creates a directory; parents optional, defaults to :false: :true creates missing parents like `mkdir -p`. permissions optional, platform default when omitted *#
  mkdir: fn(path: string, parents: bool?, permissions: number?) -> !atom,
  #* ensures a file exists, creating it empty when missing and leaving existing entries alone *#
  touch: fn(path: string) -> !atom,
  #* copies a file to a new path, overwriting the destination *#
  copy: fn(src: string, dst: string) -> !atom,
  #* renames a file or directory *#
  rename: fn(old_path: string, new_path: string) -> !atom,
  #* get file metadata as a table from a path; follow optional, defaults to :true *#
  stat: fn(path: string, follow: bool?) -> !os.Stat,
  #* file metadata as returned by file.stat and os.stat *#
  Stat: {
    size: number,
    kind: atom,
    permissions: number,
    mtime: number,
    atime: number,
    ctime: number,
  },
  #*
  find files with a patern, quite like python's glob
  ```revo
  rεvo > os.glob("src/*.md")
  {
    "./src/README.md",
  }
  rεvo > os.glob("src/**/*.md")
  {
    "./src/capi/README.md", "./src/lsp/README.md", "./src/vm/README.md",
  }
  ```
  `depth` defaults to :false, when :true it'll cause `**` to match on all subdirectories N levels deep, until it reaches the end. could be quite cpu heavy
  `recursive` defaults to :false, it means "infinite depth"
```
  *#
  glob: fn(pattern: string, recursive: bool?, depth_limit: number?) -> !table,
  #* read input options *#
  InputOpts: {
    ?delimiter: string | :nil | :eof,
  },
}

#* file handles *#
pub declare file = {
  #*
  wraps a path in a file handle table
  mode is optional, defaults to "r": "r" opens an existing path, "w" creates or truncates a file, "a" creates or keeps a file
  use `file.close()` when you're done with the handle
  *#
  open: fn(path: string, mode: string?) -> !table,
  #* reads the full file contents as a string *#
  read: fn(self: table) -> !string,
  #*
  overwrites the file with the provided string, or appends when append is :true
  optional permissions default to the platform file default
  *#
  write: fn(self: table, data: string, append: bool?, permissions: number?) -> !number,
  #* get file metadata as a table; follow optional, defaults to :true: :false leaves symlinks alone *#
  stat: fn(self: table, follow: bool?) -> !os.Stat,
  #*
  closes a file handle table
  this is currently a logical close for wrapper handles
  *#
  close: fn(self: table) -> !atom,
}
