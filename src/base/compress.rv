#* compress & decompress stuff *#
pub declare compress = {
  #* encodes data as standard base64 with padding *#
  base64_encode: fn(data: string) -> string,
  #* decodes standard base64 string *#
  base64_decode: fn(data: string) -> !string,
  #* encodes data as url-safe base64 without padding *#
  base64url_encode: fn(data: string) -> string,
  #* decodes url-safe base64 string *#
  base64url_decode: fn(data: string) -> !string,
  #* compresses data using gzip format *#
  gzip_compress: fn(data: string) -> !string,
  #* decompresses gzip data *#
  gzip_decompress: fn(data: string) -> !string,
  #* compresses data using zlib format *#
  zlib_compress: fn(data: string) -> !string,
  #* decompresses zlib data *#
  zlib_decompress: fn(data: string) -> !string,
  #* compresses data using raw deflate *#
  deflate: fn(data: string) -> !string,
  #* decompresses raw deflate data *#
  inflate: fn(data: string) -> !string,
  #* decompresses zstd data *#
  zstd_decompress: fn(data: string) -> !string,
  #* decompresses lzma data *#
  lzma_decompress: fn(data: string) -> !string,
  #* decompresses xz data *#
  xz_decompress: fn(data: string) -> !string,
}
