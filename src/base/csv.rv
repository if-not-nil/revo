#* encode values as csv and decode csvs back into revo values *#
pub declare csv = {
  #*
  encodes revo value as csv string
  
  CSVs can have options determining the delimiter (default ","), terminator (default "\r\n"), bom (unicode flag, default as off), and quote (default '"').
  
  ```repl
  rεvo > global dialect = { delimiter = ";", terminator = "~", quote = "*", bom = :false }
  rεvo > csv.encode({{"hi", "wow"}, {'yay; so cool!', "aaa"}}, dialect)
  {:ok, "hi;wow~*yay; so cool!*;aaa~"}
  rεvo > "hi;wow~*yay; so cool!*;aaa~" |> csv.decode(dialect)
  { { "hi", "wow" }, { "yay; so cool!", "aaa" } }
  ```
  
  an empty table (and later on, an optional arg) uses default csv options.
  
  ```repl
  rεvo > csv.encode({{"hi", "wow"}, {'yay; so cool!', "aaa"}})
  {:ok, "hi,wow\r\nyay; so cool!,aaa\r\n"}
  ```
  *#
  encode: fn(value: any, ?opts: csv.Opts) -> !string,
  #*
  decodes csv string into revo value
  
  CSVs can have options determining the delimiter (default ","), terminator (default "\r\n"), bom (unicode flag, default as off), and quote (default '"').
  
  ```repl
  rεvo > global dialect = { delimiter = ";", terminator = "~", quote = "*", bom = :false }
  rεvo > csv.encode({{"hi", "wow"}, {'yay; so cool!', "aaa"}}, dialect)
  {:ok, "hi;wow~*yay; so cool!*;aaa~"}
  rεvo > "hi;wow~*yay; so cool!*;aaa~" |> csv.decode(dialect)
  { { "hi", "wow" }, { "yay; so cool!", "aaa" } }
  ```
  
  an empty table (and later on, an optional arg) uses default csv options.
  
  ```repl
  rεvo > csv.encode({{"hi", "wow"}, {'yay; so cool!', "aaa"}})
  {:ok, "hi,wow\r\nyay; so cool!,aaa\r\n"}
  ```
  *#
  decode: fn(source: string, ?opts: csv.Opts) -> !any/string,
  #* csv encoding and decoding options *#
  Opts: {
    ?delimiter: string,
    ?terminator: string,
    ?quote: string | :nil,
    ?bom: bool,
  }
}
