#!/usr/bin/env revo
build first:

```bash
zig build
cp ./zig-out/lib/libraylib_revo.dylib ./raylib.so
cp ./zig-out/lib/libraylib_revo.so ./raylib.so
```

or just
```bash
./run.sh
```
!#

const rl = import './raylib.rv'

rl.init_window(800, 450, "revo + raylib")
rl.set_target_fps(60)

let x = 400.0
let y = 225.0
let speed = 4.0
let size = 30.0

while not rl.window_should_close() do
  if (rl.is_key_down(68)) x = x + speed
  if (rl.is_key_down(65)) x = x - speed
  if (rl.is_key_down(83)) y = y + speed
  if (rl.is_key_down(87)) y = y - speed

  rl.begin_drawing()
  do
    rl.clear_background(30, 30, 30)  # yeah the vscode color thats right
    rl.draw_rectangle(x, y, size, size, 0, 0, 0)
    rl.draw_text("wasd to move", 10, 10, 20, 186, 194, 222)
    rl.draw_text("esc to quit", 10, 36, 20, 186, 194, 222)
    rl.draw_fps(10, 420)
  end; rl.end_drawing()
end

rl.close_window()
