#!
colors should be tables or rgba but really arent yet
!#

const raylib: {
  #* open a window *#
  init_window: fn(width: number, height: number, title: string) -> :nil,
  #* close the window *#
  close_window: fn() -> :nil,
  #* check if close button or esc was pressed *#
  window_should_close: fn() -> bool,
  #* set target frames per second *#
  set_target_fps: fn(fps: number) -> :nil,
  #* get current fps *#
  get_fps: fn() -> number,
  #* get time in seconds for last frame *#
  get_frame_time: fn() -> number,
  #* get screen width in pixels *#
  get_screen_width: fn() -> number,
  #* get screen height in pixels *#
  get_screen_height: fn() -> number,
  #* begin drawing mode *#
  begin_drawing: fn() -> :nil,
  #* end drawing mode *#
  end_drawing: fn() -> :nil,
  #* clear background with color (r, g, b, ?a: alpha, default 255) *#
  clear_background: fn(r: number, g: number, b: number, ?a: number) -> :nil,
  #* draw text at position *#
  draw_text: fn(text: string, x: number, y: number, size: number, r: number, g: number, b: number, ?a: number) -> :nil,
  #* draw filled rectangle *#
  draw_rectangle: fn(x: number, y: number, w: number, h: number, r: number, g: number, b: number, ?a: number) -> :nil,
  #* draw filled circle *#
  draw_circle: fn(cx: number, cy: number, radius: number, r: number, g: number, b: number, ?a: number) -> :nil,
  #* draw line with thickness *#
  draw_line: fn(x1: number, y1: number, x2: number, y2: number, thick: number, r: number, g: number, b: number, ?a: number) -> :nil,
  #* draw fps counter *#
  draw_fps: fn(x: number, y: number) -> :nil,
  #* check if key was just pressed *#
  is_key_pressed: fn(key: number) -> bool,
  #* check if key is held down *#
  is_key_down: fn(key: number) -> bool,
  #* check if key was just released *#
  is_key_released: fn(key: number) -> bool,
  #* get key that was just pressed (0 if none) *#
  get_key_pressed: fn() -> number,
  #* check if mouse button was just pressed *#
  is_mouse_button_pressed: fn(button: number) -> bool,
  #* check if mouse button is held down *#
  is_mouse_button_down: fn(button: number) -> bool,
  #* get mouse x position *#
  get_mouse_x: fn() -> number,
  #* get mouse y position *#
  get_mouse_y: fn() -> number,
  #* measure text width in pixels *#
  measure_text: fn(text: string, size: number) -> number,
} = revo.dload("./raylib.so")

raylib
