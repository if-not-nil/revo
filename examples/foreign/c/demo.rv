#!/usr/bin/env revo
  demo the c extension

  build the library first:

  ```bash
  make extension
  ```
!#

const extension = import "./extension.rv"

print(extension.greet("world"))
print(extension.add(3, 4))
print(extension.echo("hello"))
print(extension.strlen("hello"))
print(extension.typ(5))
print(extension.regex("^h", "hello"))

print(extension.concat({"a", "b", "c"}, "-"))
print(extension.concat({"revo", "rules"}, ", "))

# resource demo ::: the counter is in malloc d c memory, revo holds the handle
let t = extension.total_new()
print(typeof(t))  # :resource
print(extension.total_add(t, 5))
print(extension.total_add(t, 7))
extension.total_free(t)
