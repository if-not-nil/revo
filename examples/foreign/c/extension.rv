const extension: {
  #* greets the user, like "hello, <name>!" *#
  greet: fn(name: string) -> string,
  #* adds a + b *#
  add: fn(a: number, b: number) -> number,
  #* echoes the string back *#
  echo: fn(s: string) -> string,
  #* length of a c string *#
  strlen: fn(s: string) -> number,
  #* type tag of v as a number *#
  typ: fn(v: any) -> number,
  #* regex match, hand rolled in c *#
  regex: fn(pattern: string, text: string) -> bool,
  #* joins parts with sep *#
  concat: fn(parts: table, sep: string) -> string,
  #* new counter handle in c memory, opaque until you ascribe it *#
  total_new: fn() -> any,
  #* adds to the counter, the handle is a resource and checks as one *#
  total_add: fn(handle: resource, amount: number) -> number,
  #* frees the counter handle *#
  total_free: fn(handle: any),
} = revo.dload("./extension.so")

extension
