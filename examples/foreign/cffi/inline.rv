#!/usr/bin/env revo
the inline ffi example

see ./readme.md, ./example.rv
!#

const cffi = import "./cffi.rv"

let rl = cffi.load("./libraylib.so")

print(rl)

let initwin = rl:func("InitWindow", {:i, :i, :s}, :v)

print(initwin)

initwin(640, 480, "yay")

let setfps = rl:func("SetTargetFPS", {:i}, :v)
setfps {60}

let winshcl = rl:func("WindowShouldClose", {}, :c)

let getcolor = rl:func("GetColor", {:u}, :p)
let col = getcolor {0x101042FF}

let begindraw = rl:func("BeginDrawing", {}, :v)
let cleardraw = rl:func("ClearBackground", {:p}, :v)
let drawfps = rl:func("DrawFPS", {:i, :i}, :v)
let enddraw = rl:func("EndDrawing", {}, :v)

while winshcl {} == 0 do
  begindraw {}
  cleardraw {col}
  drawfps {0, 0}
  enddraw {}
end
