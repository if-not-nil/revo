#!/usr/bin/env revo
also see ./readme.md, ./inline.rv

perfectly wrappable in a module, see:
const rl = import "./raylib"
!#

# this could all be a let rl = do...end block, if you want some scoping
const cffi = import "./cffi.rv"
let lib = cffi.load("./libraylib.so")
print(lib)

let rl = {
  initwin = lib:func("InitWindow", {:i, :i, :s}, :v),
  set_fps = lib:func("SetTargetFPS", {:i}, :v),
  window_should_close = lib:func("WindowShouldClose", {}, :c),
  getcolor = lib:func("GetColor", {:u}, :p),
  begin_draw = lib:func("BeginDrawing", {}, :v),
  clear_bg = lib:func("ClearBackground", {:p}, :v),
  draw_fps = lib:func("DrawFPS", {:i, :i}, :v),
  end_drawing = lib:func("EndDrawing", {}, :v)
}

print(rl.initwin)

rl.initwin(640, 480, "yay")

rl.set_fps(60)

let col = rl.getcolor(0x101042FF)

while rl.window_should_close {} == 0 do
  rl.begin_draw()
  rl.clear_bg(col)
  rl.draw_fps(0, 0)
  rl.end_drawing()
end
