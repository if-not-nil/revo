#!
  revo's type system!
  (not intended to be ran)
 
  | annotations are optional:
      when present, the compiler enforces them at compile time
      they also help the compiler optimize your program
 
  | untyped code defaults to dynamic (any) and works just fine
 
  | error gallery:
    uncomment the snippets below one at a time to see the helpful messages
!#

# scalar binds & coercion

type Someone = { name: string, age: number, get_age: function }
fn get_age(self: Asdf) self.age
let x: Someone = { name = "me", age = 21, get_age = get_age }

let acc = 0

for y in 0..1000
  acc += x:get_age()

print(acc)

const id = fn(x: int, y: int) x * 2

# optional: T? expands to T | :nil
let maybe: int? = 42
let nothing: int? = :nil
# let bad: int? = "str"   # expected int | :nil, got string

# union types with |
const num_or_str: int | string = 42
const other: int | string = "hi"

let nums: table<int> = { 1, 2, 3 }
let pairs: table<string, int> = { a = 1, b = 2 }

if :true 1 else "asdf"
type A = {:ok, any} | {:err, atom}

fn pick(how: A) -> any do
  print(how)
  match how
  | {:ok, v} => print("ok: ", v)
  | {:err, e} => print("err: ", e)
end

fn is_len(what) do
  const {length, str} = what
  len(str) == length
end

let pred1: A = {:err, :UhOh}
pick(pred1)

let pred2: A = {:ok, "asdf"}
pick(pred2)

# should infer
pick({:err, :Boom})

# let pred3: A = {:eee, "asdf"} # must crash
# pick(pred3)

# error: return type mismatch: wanted :true, got false
# fn hi() -> :true do
#   :false
# end

# hi()

# typed bindings: number literal inferred as number
let x: int = 42
# let bad_int: int = "hello"      # type mismatch: expected number, got string

# typed bindings: float literal inferred as number
let y: number = 3.14

# int coerces to number (allowed)
let z: number = 10


# functions & params

# typed function params: both args must be int, result inferred
fn add(a: int, b: int) a + b
let sum = add(3, 4)
# add(3, "wrong")    # argument 2 to `add` expects int, got string
# add("wrong", 3)    # argument 1 to `add` expects int, got string

# typed function return validation
# fn bad_return() -> int do
#     return "oops"
# end

# typed function with return type annotation
fn double(n: int) -> int do
    return n * 2
end
let doubled = double(5)
# double("hello")  # argument 1 to `double` expects int, got string

# typed function with mixed params
const scale = fn(v: number, factor: number) v * factor
let scaled = scale(2.5, 4)

# nested function with typed params
const outer = fn(n: int) do
    const inner = fn(x: int) x * 2
    inner(n) + 1
end
let nested = outer(5)


# generics!!! explicit [T] params with call-site substitution
#
# the function body compiles once, type params stay abstract in the body
# at each call site, the compiler substitutes concrete types for the return
#

# generic identity: T inferred from argument
fn identity[T](x: T) x
let id_int = identity(42)
let id_str = identity("hello")

# repeated type param: both args must match
fn repeat[T](x: T, y: T) x
let rep = repeat(1, 2)
# repeat(1, "asdf")   # argument 2 to `repeat` expects same type as argument 1


# multiple type params with table return
fn swap[T, U](a: T, b: U) -> {U, T}
  return {b, a}

let swapped = swap(1, "two")

# compound return type with type param
fn wrap[T](x: T) -> {:ok, T}
  return {:ok, x}
let wrapped = wrap(42)

# non-inferrable: return-only type param needs explicit annotation
# provide type args at the call site: ident[T, U](args)
fn make[T](x) -> T
  return x
# let y = make(1)                # cannot infer T: only used in return
let y = make[int](1)             # explicit T=int makes it work

# return-only type param (zero runtime args)
fn zero[T]() -> T
  return 0
let z = zero[int]()              # T=int, returns int 0


# tables & field validation
# > table fields use `number` at runtime

type Point = { x: number, y: number }

# create typed table & modify fields
let p: Point = { x = 10, y = 20 }

let px = p.x
p.x = 100
# p.x = "not a number" # field `x` wants number, got string
# let bad_point = { x = 10, y = "oops" }

type Person = { name: string, age: number }

# create typed table & modify fields
let person: Person = { name = "alice", age = 30 }

let pname = person.name
# person.name = 42 # field `name` wants string, got number

# associated methods are done via metatables
person:set_meta({
	fn get_name(self: Person) -> string
		self.name
})
