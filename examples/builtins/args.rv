#!/usr/bin/env revo
Usage: argparse.parse BUILDER ARGS
	Parse CLI args with flags, options, commands, and positionals.


Subcommands:
	p:flag(name: atom, opts: table)
	p:option(name: atom, opts: table)
	p:command(name: atom, opts: table)
	p:positional(name: atom, opts: table)


All arguments to opts are optional:
	short        string
		the shorthand for the argument, like -v
	description  string
	  description to be displayed in the usage
	terminal     bool
	  stop parsing after this arg is filled
	passthrough  bool
	  pass remaining args to child
	prefix       bool
		treat the option as a prefix


Examples:
	./args.rv
	./args.rv -v -o out.txt main.rv
	./args.rv compile -v
	./args.rv --unknown


Output status:
	result.err: nil | { token = string, message = string }
	result.flags: table of flag names to values
	result.commands: table of command names to booleans
	result.positionals: table of positional names to values
	result.leftover: table of unconsumed args


Report bugs to <https://github.com/if-not-nil/revo/issues>
!#

const result = argparse.parse(fn(p) do
  p:flag(:verbose, {short = "v", description = "enable verbose output"})
  p:option(:output, {short = "o", description = "output file"})
  p:command(:compile, {description = "compile a file"})
  p:positional(:script, {description = "input script"})
end, argv)

if result.err do
  print("error:", result.err)
end else do
  print("flags:", result.flags)
  print("commands:", result.commands)
  print("positionals:", result.positionals)
  print("leftover:", result.leftover)
  print("")
  print(argparse.usage(result))
end
