# built-in for tables, strings
for v in {10, 20, 30} do print(v) end
# 10 20 30

for v in {1, 2, 3} do print(v) end
# 1 2 3

for c in "hi" do print(c) end
# "h" "i"

# lazy arithmetic sequences
for x in iter.range(5) do print(x) end
# 0 1 2 3 4

for x in iter.range(1, 6) do print(x) end
# 1 2 3 4 5

for x in iter.range(0, 10, 3) do print(x) end
# 0 3 6 9

# pipes and transformers (all lazy, collect to materialize)
iter.range(10)
  :filter(fn(x) x % 2 == 0)
  :collect()
  |> for x in _ print(x)
# { 0, 2, 4, 6, 8 }

iter.range(1, 11)
  :map(fn(x) x * x)
  :filter(fn(x) x > 20)
  :take(3)
  :collect()
# {25, 36, 49}

iter.range(1, 6) |> iter.fold(fn(a, b) a * b)
# 120

#
# custom object with an __iter metamethod
#
# 
let Counter = set_meta({
  {:zero, "none"},
  {:one, "singular"},
  {:two, "pair"},
  {:three, "crowd"}
}, {
  __iter = fn(self) do
    let idx = 0
    let n = len(self)
    fn() match idx
      | x when (x >= n) => :done
      | _ => do
        let val = self[idx]
        idx += 1
        val
    end
  end
})

for entry in Counter do print(entry) end
# {:zero, "none"} {:one, "singular"} {:two, "pair"} {:three, "crowd"}

fn data_fn(self) do
  let idx = 0
  let n = len(self)
  fn() match idx
    | x when (x >= n) => :done
    | _ => do
        let val = self[idx] * 2
        idx += 1
        val
    end
end

let data = set_meta({10, 20, 30, 40}, { __iter = data_fn })

for x in data do print(x) end
# 20 40 60 80

for x, i in data do print(i, x) end
# 0 20; 1 40; 2 60; 3 80
# iterator is still just a value

let data2 = {10, 20, 30}
let iter2 = iter.to_iter(data2)
print(iter2())
print(iter2())
print(iter2())
print(iter2())
# 10 20 30 :done
