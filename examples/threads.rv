#!/usr/bin/env revo
threads example!
this is not marked as executable via a shebang
, because i need you to set a thread number via the `--threads` flag explicitly

try `revo --threads=4 ./threads.rv`
and `revo --threads=2 ./threads.rv`
!#

if (revo.threads() == 1)
  print("""
  wait! you only have one thread dedicated to revo.
  you should run this with the --threads=4 flag instead
  =====================================================
  """)

# it needs to be a heap object,
# that's why we use a table instead of a nubmer
let waitgroup = {0}


fn worker(name: string) do
  waitgroup.0 += 1

  # some important work that takes one second happens here...
  """
  sleep 0.5
  echo #{name}\\'s job got done at $(date +%T)
  """
    |> system({"bash", "-c", _})?
    |> _[0]  # stdout
    |> print()

  waitgroup.0 -= 1
end


let {start, jobs} = {time.now(), {}}

jobs:push(spawn worker("alice"))
jobs:push(spawn worker("bob"))
jobs:push(spawn worker("carol"))
jobs:push(spawn worker("dave"))

for i in..(revo.threads() - 4)
  jobs:push(spawn worker("#{i}"))

for job in jobs do
  join(job)
end

print("on #{revo.threads()} threads, #{math.max(revo.threads(), 4)} jobs were completed in #{time.now() - start}ms")
