#!/usr/bin/env revo
 λ
 λ  macro metaprogramming in revo
 λ
 λ  macros can evaluate any runtime code, which makes this possible
 λ
 @author ryzh
!#

proc doto!(m) do
  let items = m.items

  let object = items[0]

  fn action_to_call(action) do
    let method = action[1][1]
    let args = action[2]
    let call = {:call, {:field, object, method}, args, :true, {}}
    call
  end

  let calls = { }

  for i in 1..len(items) do
    let action = items[i]
    let call = action_to_call(action)
    # print("CALL", call)
    calls:push(call)
  end

  {{:block, calls}}
end

let grunt = {
  name = "Grunt",
  hp = 30,
  max_hp = 30,
  attack = 8,
  defense = 3,
  inventory = {},
  weapon = "rusty dagger",
  armor = "leather scraps",
  faction = "Bleakwood",
  rage = 0,

  set_name = fn(self, name) self.name = name,
  set_hp = fn(self, hp) self.hp = hp,
  set_attack = fn(self, attack) self.attack = attack,
  set_defense = fn(self, defense) self.defense = defense,
  add_item = fn(self, item) self.inventory = self.inventory:push(item),
  set_weapon = fn(self, weapon) self.weapon = weapon,
  set_armor = fn(self, armor) self.armor = armor,
  set_faction = fn(self, faction) self.faction = faction,
  enrage = fn(self) do
    self.rage = 10
    self.attack = self.attack + 5
    print(self.name, "enrages! He waves his", self.weapon, "aggressively. Attack increased to", self.attack)
  end,
}

doto!(
  grunt,
  set_hp(45),
  set_attack(12),
  set_name("Snaggletooth"),
  set_defense(5),
  add_item("healing potion"),
  add_item("goblin ears"),
  set_weapon("serrated cleaver"),
  set_armor("studded hide"),
  set_faction("Redmaw"),
  enrage(),
)

print(grunt)
