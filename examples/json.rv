#!/usr/bin/env revo
  
  ```json
  [
    "reads json from stdin, pretty-prints a revo table into stdout",
    "does not use the builtin json.decode functionality",
    "use `revo --test json.rv` to run the tests",
  ]
  { "@author": "vividsector" }
  ```

!#

#* the entrypoint *#
fn parse_json(s: string) -> !{num, table}
	parse(s, 0)

fn parse(s, i) do
	match s[i]
		| c when is_numeric(c) => parse_num(s, i)
		| 'n' => parse_null(s, i)
		| 't' => parse_bool(s, i)
		| 'f' => parse_bool(s, i)
		| '[' => parse_list(s, i)
		| '{' => parse_map(s, i)
		| '"' => parse_string(s, i)
end

fn is_numeric(c) c:len() > 0 and "-0123456789.":contains?(c)

fn parse_string(s, i) do
	let count = 1
	let output = {}
	loop/chars do
		let c = s[i + count]
		let n = match c
			| '\\' => do
				count += 1
				s[i + count]
			end
			| '"' => break/chars(:nil)
			| _ => c
		output:push(n)
		count += 1
	end
	count += tag(s, i + count, '"')?
	{:ok, {count, output:join("")}}
end

fn parse_map_entry(s, i) do
	let {count, key} = parse_string(s, i)?
	count += ws(s, i + count)
	count += tag(s, i + count, ":")?
	count += ws(s, i + count)
	let {val_len, val} = parse(s, i + count)?
	count += val_len
	count += ws(s, i + count)
	{:ok, {count, key, val}}
end

fn parse_map(s, i) do
	let count = 1
	count += ws(s, i + count)
	let output = {}
	match parse_map_entry(s, i + count)
		| {:ok, {len, first_key, first_val}} => do
			output[first_key] = first_val
			count += len
			while tag(s, i + count, ",").0 == :ok do
				count += 1
				count += ws(s, i + count)
				let {l, key, val} = parse_map_entry(s, i + count)?
				count += l
				output[key] = val
			end
		end
		| _ => ()
	count += tag(s, i + count, "}")?
	{:ok, {count, output}}
end

fn parse_list(s, i) do
	let count = 1
	count += ws(s, i + count)
	let output = {}
	match parse(s, i + count)
		| {:ok, {len, val}} => do
			output:push(val)
			count += len
			count += ws(s, i + count)
			while tag(s, i + count, ",").0 == :ok do
				count += 1
				count += ws(s, i + count)
				let {l, elem} = parse(s, i + count)?
				count += l
				count += ws(s, i + count)
				output:push(elem)
			end
		end
		| _ => ()
	count += tag(s, i + count, "]")?
	{:ok, {count, output}}
end

fn tag(s, i, symbol) do
	if (s:sub(i, symbol:len()) == symbol)
    {:ok, symbol:len()}
  else {:err, 'expected ':add(symbol)}
end

fn parse_num(s, i) do
	let count = 0
	while (i + count < s:len() and is_numeric(s[i + count]))
		count += 1
	let num = number(s:sub(i, count))?
	{:ok, {count, num}}
end

fn parse_null(s, i)
	if s:sub(i, 4) == "null" {:ok, {4, :nil}} else {:err, "expected 'null'"}

fn parse_bool(s, i) do
	if s:sub(i, 4) == "true"
		{:ok, {4, :true}}
	else if s:sub(i, 5) == "false"
		{:ok, {5, :false}}
	else {:err, "expected boolean"}
end

fn ws(s, i) do
	let count = 0
	while (i + count < s:len() and " \n":contains?(s[i + count]))
    count += 1
	count
end

parse_json('{ "a": 1 }')?
|> expect_eq({10, { "a" = 1 }})
parse_json('[ 1, 2 ]')?
|> expect_eq({7, { 1, 2 }})

loop parse_json(input()?)
     |> print("#{_:p}")
