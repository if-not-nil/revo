# used throughout redhat dino's development process @ https://arxiv.org/pdf/1604.01290
let start = os.now()

const n: number = 25
let x: number = 0

for _ in 0..n
  for _ in 0..n
    for _ in 0..n
      for _ in 0..n
        for _ in 0..n
          for _ in 0..n
            x += 1

print(x)

print(fmt("took %v", (os.now() - start)/1000))
